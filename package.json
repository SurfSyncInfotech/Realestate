{
  "name": "realestate-marketplace",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "database"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md,html}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md,html}\"",
    "db:check": "npm run check --workspace @realestate/database",
    "db:migrate": "npm run migrate:latest --workspace @realestate/database",
    "db:rollback": "npm run migrate:rollback --workspace @realestate/database",
    "db:seed": "npm run seed:run --workspace @realestate/database",
    "db:accounts": "npm run accounts --workspace @realestate/database",
    "db:setup": "npm run setup --workspace @realestate/database",
    "start:prod": "npm run start --workspace backend",
    "db:reset-password": "npm run reset-password --workspace @realestate/database --",
    "mail:setup": "npm run mail:setup --workspace backend"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "prettier": "^3.6.2"
  }
}